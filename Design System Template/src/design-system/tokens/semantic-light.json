{
  "$description": "Semantic tokens — light theme. Named roles that reference primitive tokens. Components only consume these (never raw primitives).",
  "semantic": {
    "color": {
      "background":            { "$type": "color", "$value": "{color.surface.50}" },
      "foreground":            { "$type": "color", "$value": "{color.primary.950}" },

      "card":                  { "$type": "color", "$value": "{color.surface.50}" },
      "card-foreground":       { "$type": "color", "$value": "{color.primary.950}" },

      "popover":               { "$type": "color", "$value": "{color.surface.50}" },
      "popover-foreground":    { "$type": "color", "$value": "{color.primary.950}" },

      "muted":                 { "$type": "color", "$value": "{color.surface.100}" },
      "muted-foreground":      { "$type": "color", "$value": "{color.surface.500}" },

      "primary":               { "$type": "color", "$value": "{color.primary.800}" },
      "primary-foreground":    { "$type": "color", "$value": "{color.primary.50}" },
      "primary-hover":         { "$type": "color", "$value": "{color.primary.900}" },
      "primary-active":        { "$type": "color", "$value": "{color.primary.950}" },

      "border":                { "$type": "color", "$value": "{color.control.200}" },
      "border-strong":         { "$type": "color", "$value": "{color.control.300}" },

      "input":                 { "$type": "color", "$value": "{color.control.50}" },
      "input-border":          { "$type": "color", "$value": "{color.control.200}" },
      "input-border-hover":    { "$type": "color", "$value": "{color.control.300}" },
      "input-placeholder":     { "$type": "color", "$value": "{color.control.500}" },

      "ring":                  { "$type": "color", "$value": "{color.control.400}" },

      "disabled":              { "$type": "color", "$value": "{color.control.100}" },
      "disabled-foreground":   { "$type": "color", "$value": "{color.control.500}" },

      "error":                 { "$type": "color", "$value": "{color.red.500}" },
      "error-foreground":      { "$type": "color", "$value": "{color.surface.50}" },
      "error-subtle":          { "$type": "color", "$value": "{color.red.50}" },

      "destructive":           { "$type": "color", "$value": "{color.red.500}" },
      "destructive-foreground":{ "$type": "color", "$value": "{color.surface.50}" },
      "destructive-hover":     { "$type": "color", "$value": "{color.red.600}" },
      "destructive-active":    { "$type": "color", "$value": "{color.red.700}" },

      "success":               { "$type": "color", "$value": "{color.green.500}" },
      "success-foreground":    { "$type": "color", "$value": "{color.surface.50}" },
      "success-subtle":        { "$type": "color", "$value": "{color.green.50}" },
      "success-hover":         { "$type": "color", "$value": "{color.green.600}" },

      "warning":               { "$type": "color", "$value": "{color.amber.500}" },
      "warning-foreground":    { "$type": "color", "$value": "{color.surface.950}" },
      "warning-subtle":        { "$type": "color", "$value": "{color.amber.50}" },
      "warning-hover":         { "$type": "color", "$value": "{color.amber.600}" },

      "info":                  { "$type": "color", "$value": "{color.blue.500}" },
      "info-foreground":       { "$type": "color", "$value": "{color.surface.50}" },
      "info-subtle":           { "$type": "color", "$value": "{color.blue.50}" },
      "info-hover":            { "$type": "color", "$value": "{color.blue.600}" }
    }
  }
}
