# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# content engine — raw journal stays local & private
/content/journal/*
!/content/journal/.gitkeep

# Source materials for case studies (not for production)
/assets/
/mindful me mock ups/
/mindfulme_casestudy/
/old_casestudy_assets/
/growth-audit/

# Personal notes
/Because tools make competence cheap.md

# Local-only files (outreach leads, session handoffs with client names)
*.local.md

# Machine-local runtime state
.claude/scheduled_tasks.lock

/Animation thumbnails/
content/social/SCHEDULE-REVIEW.md
content/social/LINKEDIN-REVIEW.md
content/social/.typefully-state.json

# HyperFrames build output (keep the composition source)
videos/**/node_modules/
videos/**/renders/
videos/**/snapshots/
videos/**/.hyperframes/

# Responsive check output (regenerate with `npm run check:responsive`)
responsive-check-report.json
responsive-check-shots/
