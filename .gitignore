# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# content engine — raw journal stays local & private
/content/journal/*
!/content/journal/.gitkeep

# Source materials for case studies (not for production)
/assets/
/mindful me mock ups/
/mindfulme_casestudy/
/old_casestudy_assets/
/growth-audit/
# The Audemic deck exports. 17MB of source PNGs; the shipped versions are webp at
# 1920px under public/work/audemic-*, about 2.8MB. Also holds the two photos that
# stay unpublished — one has colleagues' names rendered into it, one shows an
# identifiable face.
/Cast studie/

# Personal notes
/Because tools make competence cheap.md

# Local-only files (outreach leads, session handoffs with client names)
*.local.md
# The cold-outreach handoff. Added 2026-07-16, removed the same day for being in a
# public repo, restored sanitized, and untracked here on 2026-08-06 so future edits
# stay local. NOTE: the sanitized version is still reachable in history (699aaf4) —
# untracking stops new leaks, it doesn't erase the old ones.
/SESSION-HANDOFF.md

# Machine-local runtime state
.claude/scheduled_tasks.lock

/Animation thumbnails/
content/social/SCHEDULE-REVIEW.md
content/social/LINKEDIN-REVIEW.md
content/social/.typefully-state.json

# HyperFrames build output (keep the composition source)
videos/**/node_modules/
videos/**/renders/
videos/**/snapshots/
videos/**/.hyperframes/

# Responsive check output (regenerate with `npm run check:responsive`)
responsive-check-report.json
responsive-check-shots/

# Copy drafts pasted in from outside the repo — kept so Richard can keep editing
# them, not published. The published copy lives in content/published/.
/Modern ui update (partial)
/Afi web design system blog

# ── Public-repo audit, 2026-08-26 ────────────────────────────────────────────
# This repo is public. Everything below stays local: it either quotes people who
# never agreed to be published, names client work under NDA-shaped expectations,
# or is working machinery that reads badly to anyone outside the workflow.
#
# NOTE, same caveat as SESSION-HANDOFF.md above: untracking stops new leaks, it
# does not erase what history already holds.

# Drafts quote private Granola meetings verbatim — named colleagues, named Afi
# clients (Renta 4, Mutualidad, Santander, Sabadell, Kutxa, Caixa), a manager's
# candid feedback. Drafts stay local; only content/published/ goes out.
/content/drafts/*
!/content/drafts/.gitkeep

# The content factory: story bank of raw internal project notes, plus voice
# examples that are screenshots of another creator's posts.
/content/content-os/

# Outreach playbook + target list — ~18 real people with follower tiers and a
# log of who was engaged. Any of them could read their own row.
/content/social/outreach.md
/content/social/outreach-targets.md
# The posting schedule: months of pre-written posts and how they're spaced.
/content/social/backlog.md
/content/social/edit-*.md

# Afi internal course material ("Curso interno. Taller de Escritura") — not ours
# to redistribute.
/Spanish writting principles.pdf

# Stray personal/scratch files that keep landing in the repo root.
*.HEIC
*.heic
/scratch-*.png
