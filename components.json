{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@reui": "https://reui.io/r/{name}.json",
    "@spaceui": "https://www.spaceui.one/r/{name}.json",
    "@audiocn": "https://www.audiocn.dev/r/{name}.json",
    "@componentry": "https://componentry.dev/r/{name}.json",
    "@skecher": "https://skecher-ui.com/r/{name}.json",
    "@arc": "https://uiarc.dev/r/{name}.json",
    "@obsidian": "https://www.obsidianui.dev/r/{name}.json"
  }
}
